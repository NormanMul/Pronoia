{
  "name": "pronoia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "typecheck": "npm run build -w @pronoia/core && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build -w @pronoia/core && npm run build -w @pronoia/cli",
    "pronoia": "node packages/cli/dist/index.js",
    "demo:seed": "node packages/cli/dist/index.js demo-seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "5.1.0"
  }
}
